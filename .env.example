# ============================================================
# 复制本文件为项目根目录的 .env，再填入真实密钥：
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# 不要把 .env 提交到 Git（已在 .gitignore）
# ============================================================

# --- 可选但推荐：GitHub Token（拉 README 时提高限额）---
# 申请：https://github.com/settings/tokens
# 权限：公开仓库只读即可（classic: public_repo 或不勾选私有权限）
GITHUB_TOKEN=

# --- 必填（第三步摘要）：LLM API Key ---
# DeepSeek 示例（默认）：
#   控制台：https://platform.deepseek.com/
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 若用 OpenAI：
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com
# LLM_MODEL=gpt-4o-mini

# 若用通义（OpenAI 兼容模式），按控制台文档填写 BASE_URL 与 MODEL

# --- 拉榜参数（可选）---
TRENDING_SINCE=daily
TRENDING_LANGUAGE=
TRENDING_TOP_N=10

# README 截断长度（字符）
README_MAX_CHARS=12000

# --- 第四步 Web（可选）---
HOST=0.0.0.0
PORT=8000
